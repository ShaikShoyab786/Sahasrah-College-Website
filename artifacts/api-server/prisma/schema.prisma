  @@unique([homepageFavoriteTopicsId, displayOrder])
  @@index([homepageFavoriteTopicsId])
}

model HomepageResults {
  id                String            @id @default("singleton")
  eyebrow           String
  heading           String
  description       String
  viewAllButtonLabel String           @default("View All Achievements")
  viewAllButtonLink  String           @default("/results")
  isVisible         Boolean           @default(true)

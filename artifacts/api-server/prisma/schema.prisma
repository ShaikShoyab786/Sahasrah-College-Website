  description String   @default("Explore the spaces, people, and experiences that make life at Sahasrah College memorable.")
  updatedAt   DateTime @updatedAt
}

model GalleryImportState {
  id         String   @id @default("singleton")
  importedAt DateTime @default(now())
}

model GalleryItem {
  id                  String   @id @default(cuid())
  sourceAboutId       String?  @unique
  imageUrl            String?
  imageAltText        String
  title               String
  description         String?
  category            String   @default("Campus")
  locationLabel       String?
  isPublished         Boolean  @default(true)
  displayOrder        Int      @default(1)
  showInHomePreview   Boolean  @default(false)
  homePreviewOrder    Int      @default(1)
  updatedAt           DateTime @updatedAt

  @@index([isPublished, displayOrder])
  @@index([isPublished, showInHomePreview, homePreviewOrder])
}

model AboutAchievements {
  id          String                    @id @default("singleton")
  eyebrow     String                    @default("OUR IMPACT")
  heading     String
  description String
  isVisible   Boolean                   @default(true)
  sortOrder   Int                       @default(8)
  updatedAt   DateTime                  @updatedAt
  statistics  AboutAchievementStatistic[]
}

model AboutAchievementStatistic {
  id                  String           @id @default(cuid())
  aboutAchievementsId String           @default("singleton")
  numericTarget       Int
  suffix              String
  icon                String?
  label               String
  displayOrder        Int
  isVisible           Boolean          @default(true)
  updatedAt           DateTime         @updatedAt
  aboutAchievements   AboutAchievements @relation(fields: [aboutAchievementsId], references: [id], onDelete: Cascade)

  @@unique([aboutAchievementsId, displayOrder])
  @@index([aboutAchievementsId])
}

model AboutFaq {
  id                          String         @id @default("singleton")
  eyebrow                     String         @default("NEED TO KNOW")
  heading                     String
  description                 String
  helpEyebrow                 String         @default("Admissions help")
  helpHeadingWithCounselor    String         @default("Still Have Questions?")
  helpHeadingWithoutCounselor String         @default("Talk with our admissions team.")
  helpDescription             String         @default("Our admission experts are here to help you compare programs, plan a campus visit, and take the next step.")
  isVisible                   Boolean        @default(true)
  sortOrder                   Int            @default(9)
  updatedAt                   DateTime       @updatedAt
  questions                   AboutFaqItem[]
}

model AboutFaqItem {
  id          String      @id @default(cuid())
  aboutFaqId  String      @default("singleton")
  question    String
  answer      String
  displayOrder Int
  isVisible   Boolean     @default(true)
  updatedAt   DateTime    @updatedAt
  aboutFaq    AboutFaq    @relation(fields: [aboutFaqId], references: [id], onDelete: Cascade)

  @@unique([aboutFaqId, displayOrder])
  @@index([aboutFaqId])
}

model AboutAdmissionCta {
  id                    String   @id @default("singleton")
  eyebrow               String   @default("ADMISSIONS 2026–27")
  heading               String
  supportingText        String
  applyButtonLabel      String
  applyButtonHref       String
  campusVisitButtonLabel String
  campusVisitButtonHref String
  prospectusButtonLabel String
  prospectusButtonHref  String
  backgroundImage       String?
  backgroundImageAltText String
  counselorButtonLabel  String
  counselorButtonHref   String
  admissionPhone        String
  workingHours          String
  isVisible             Boolean  @default(true)
  sortOrder             Int      @default(10)
  updatedAt             DateTime @updatedAt
}
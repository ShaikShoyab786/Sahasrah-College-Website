generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String
  displayName  String
  createdAt    DateTime        @default(now())
  sessions     AdminSession[]
}

model AdminSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  adminId   String
  expiresAt DateTime
  createdAt DateTime @default(now())
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model SiteSettings {
  id                       String  @id @default("singleton")
  collegeName              String
  tagline                  String
  logoUrl                  String?
  email                    String
  phone                    String
  address                  String
  primaryColor             String
  accentColor              String
  surfaceColor             String @default("#F5F7FB")
  themePreset              String @default("sahsrah-blue-red")
  footerText               String
  introEnabled             Boolean @default(true)
  introQuote               String  @default("Best place to learn")
  loginLeftEyebrow         String  @default("ACADEMIC ADMINISTRATION")
  loginLeftHeading         String  @default("Manage with")
  loginLeftHighlightedHeading String @default("clarity and purpose.")
  loginLeftDescription      String  @default("A secure workspace for managing Sahsrah Junior College operations, academic information, student records, and institutional updates.")
  loginLeftBottomText       String  @default("Authorized administrators only · Internal use")
  loginBackgroundImageUrl   String?
  loginBackgroundImageAltText String @default("Sahsrah Junior College academic administration workspace")
  loginRightEyebrow        String  @default("ADMIN WORKSPACE")
  loginRightHeading         String  @default("Welcome back.")
  loginRightDescription     String  @default("Sign in to access Sahsrah's administrative workspace.")
  loginEmailLabel           String  @default("Official email address")
  loginPasswordLabel        String  @default("Password")
  loginButtonLabel          String  @default("Sign in →")
  loginSecurityNote         String  @default("This workspace is restricted to authorized Sahsrah administrators.")
  loginBackLinkLabel        String  @default("Back to website")
  updatedAt                 DateTime @updatedAt
}

model ContactSettings {
  id                       String   @id @default("singleton")
  eyebrow                  String
  heading                  String
  description              String
  formHeading              String
  formDescription          String
  responseTimeMessage      String
  mainEmail                String
  primaryPhone             String
  additionalPhones         String   @default("[]")
  whatsappNumber           String
  address                  String
  workingHours             String
  mapEmbedUrl              String?
  mapLabel                 String
  logoUrl                  String?
  socialLinks              String   @default("[]")
  courseOptions            String   @default("[\"MPC\",\"BiPC\"]")
  nameLabel                String
  phoneLabel               String
  courseLabel              String
  emailLabel               String
  messageLabel             String
  submitButtonLabel        String
  successMessage           String
  prospectusButtonLabel    String
  prospectusButtonHref     String
  campusVisitButtonLabel   String
  campusVisitButtonHref    String
  callbackPopupEnabled     Boolean  @default(true)
  callbackPopupDelaySeconds Int     @default(7)
  callbackPopupEyebrow     String   @default("A QUICK CALLBACK")
  callbackPopupHeading     String   @default("Would you like us to call you?")
  callbackPopupDescription String   @default("Share your details and our admissions team will get in touch.")
  callbackPopupNameLabel   String   @default("Student or parent name")
  callbackPopupPhoneLabel  String   @default("Indian mobile number")
  callbackPopupCourseLabel String   @default("Course of interest (optional)")
  callbackPopupEmailLabel  String   @default("Email address (optional)")
  callbackPopupMessageLabel String  @default("What would you like to know? (optional)")
  callbackPopupSubmitButtonLabel String @default("Request a callback")
  callbackPopupSuccessMessage String @default("Thank you. Our admissions team will call you soon.")
  isVisible                Boolean  @default(true)
  updatedAt                DateTime @updatedAt
}

model ContactEnquiry {
  id                String   @id @default(cuid())
  name              String
  phone             String
  course            String?
  source            String   @default("contact-form")
  email             String?
  message           String?
  deliveryStatus    String   @default("stored")
  deliveryError     String?
  whatsappRecipient String?
  contacted         Boolean  @default(false)
  resolved          Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([deliveryStatus])
  @@index([contacted, resolved])
  @@index([createdAt])
}

model HomepageHero {
  id                     String  @id @default(cuid())
  displayOrder           Int     @unique @default(1)
  eyebrowText            String
  heading                String
  highlightedHeadingText String
  description            String

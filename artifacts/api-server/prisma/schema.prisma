  isActive     Boolean  @default(true)
  displayOrder Int
  updatedAt    DateTime @updatedAt

  @@unique([displayOrder])
  @@index([isActive, isFeatured, publishDate])
}

model HomepagePreviewCopy {
  id                     String   @id @default("singleton")
  liveUpdatesEyebrow     String   @default("From Sahsrah")
  liveUpdatesHeading     String   @default("Live Updates")

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String
  displayName  String
  createdAt    DateTime        @default(now())
  sessions     AdminSession[]
}

model AdminSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  adminId   String
  expiresAt DateTime
  createdAt DateTime @default(now())
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model SiteSettings {
  id           String  @id @default("singleton")
  collegeName  String
  tagline      String
  logoUrl      String?
  email        String
  phone        String
  address      String
  primaryColor String
  accentColor  String
  footerText   String
  updatedAt    DateTime @updatedAt
}

model HomepageHero {
  id                     String  @id @default(cuid())
  displayOrder           Int     @unique @default(1)
  eyebrowText            String
  heading                String
  highlightedHeadingText String
  description            String
  primaryButtonLabel     String
  primaryButtonUrl       String
  secondaryButtonLabel   String
  secondaryButtonUrl     String
  heroImageUrl           String?
  heroImageAltText       String  @default("Sahasara Junior College students learning together")
  isPublished             Boolean @default(true)
  updatedAt              DateTime @updatedAt
}

model HomepageAboutPreview {
  id                    String   @id @default("singleton")
  eyebrow               String
  heading               String
  description           String
  body                  String
  buttonLabel           String
  buttonHref            String
  primaryImage          String?
  primaryImageAltText   String
  secondaryImage        String?
  secondaryImageAltText String
  isVisible             Boolean  @default(true)
  sortOrder             Int      @default(2)
  updatedAt             DateTime @updatedAt
}

model AboutHero {
  id                       String   @id @default("singleton")
  eyebrow                  String
  heading                  String
  description              String
  mainImageUrl             String?
  mainImageAltText         String
  floatingLabel             String
  floatingAcademicYear     String
  floatingAvailabilityText String
  floatingSupportingText   String
  floatingImageUrl         String?
  floatingImageAltText     String
  primaryButtonLabel       String
  primaryButtonUrl         String
  primaryButtonVisible     Boolean  @default(true)
  secondaryButtonLabel     String
  secondaryButtonUrl       String
  secondaryButtonVisible   Boolean  @default(true)
  isVisible                Boolean  @default(true)
  sortOrder                Int      @default(1)
  updatedAt                DateTime @updatedAt
  stats                    AboutHeroStat[]
}

model AboutHeroStat {
  id          String    @id @default(cuid())
  aboutHeroId String    @default("singleton")
  value       String
  label       String
  icon        String?
  displayOrder Int
  isVisible   Boolean   @default(true)
  updatedAt   DateTime  @updatedAt
  aboutHero   AboutHero @relation(fields: [aboutHeroId], references: [id], onDelete: Cascade)

  @@unique([aboutHeroId, displayOrder])
  @@index([aboutHeroId])
}

model AboutStory {
  id                    String              @id @default("singleton")
  eyebrow               String
  heading               String
  description           String
  buttonLabel           String
  buttonHref            String
  mainImage              String?
  mainImageAltText       String
  secondaryImage         String?
  secondaryImageAltText  String
  thirdImage             String?
  thirdImageAltText      String
  isVisible              Boolean             @default(true)
  sortOrder              Int                 @default(2)
  updatedAt              DateTime            @updatedAt
  timelineItems         AboutTimelineItem[]
}

model AboutTimelineItem {
  id          String     @id @default(cuid())
  aboutStoryId String    @default("singleton")
  period      String
  title       String
  description String
  displayOrder Int
  isVisible   Boolean    @default(true)
  updatedAt   DateTime   @updatedAt
  aboutStory  AboutStory @relation(fields: [aboutStoryId], references: [id], onDelete: Cascade)

  @@unique([aboutStoryId, displayOrder])
  @@index([aboutStoryId])
}

model AboutChairmanMessage {
  id             String   @id @default("singleton")
  eyebrow        String
  heading        String
  message        String
  signatureName  String
  role           String
  portraitImage  String?
  portraitAltText String
  buttonLabel    String
  buttonHref     String
  buttonVisible  Boolean  @default(false)
  isVisible      Boolean  @default(true)
  sortOrder      Int      @default(3)
  updatedAt      DateTime @updatedAt
}

model AboutGuidingPrinciples {
  id                String                    @id @default("singleton")
  heading           String
  description       String
  visionIcon        String
  visionTitle       String
  visionDescription String
  missionIcon       String
  missionTitle      String
  missionDescription String
  valuesIcon        String
  valuesTitle       String
  isVisible         Boolean                   @default(true)
  sortOrder         Int                       @default(4)
  updatedAt         DateTime                  @updatedAt
  values            AboutGuidingPrincipleValue[]
}

model AboutGuidingPrincipleValue {
  id                    String                  @id @default(cuid())
  aboutGuidingPrinciplesId String                @default("singleton")
  value                 String
  displayOrder          Int
  isVisible             Boolean                 @default(true)
  updatedAt             DateTime                @updatedAt
  aboutGuidingPrinciples AboutGuidingPrinciples @relation(fields: [aboutGuidingPrinciplesId], references: [id], onDelete: Cascade)

  @@unique([aboutGuidingPrinciplesId, displayOrder])
  @@index([aboutGuidingPrinciplesId])
}

model AboutWhyParentsChoose {
  id          String                    @id @default("singleton")
  heading     String
  description String
  isVisible   Boolean                   @default(true)
  sortOrder   Int                       @default(5)
  updatedAt   DateTime                  @updatedAt
  benefits    AboutParentChoiceBenefit[]
}

model AboutParentChoiceBenefit {
  id                   String                @id @default(cuid())
  aboutWhyParentsChooseId String             @default("singleton")
  icon                 String
  title                String
  description          String
  displayOrder         Int
  isVisible            Boolean               @default(true)
  updatedAt            DateTime              @updatedAt
  aboutWhyParentsChoose AboutWhyParentsChoose @relation(fields: [aboutWhyParentsChooseId], references: [id], onDelete: Cascade)

  @@unique([aboutWhyParentsChooseId, displayOrder])
  @@index([aboutWhyParentsChooseId])
}

model AboutLeadershipMember {
  id                String          @id @default(cuid())
  aboutLeadershipId String          @default("singleton")
  portraitImage     String?
  portraitAltText   String
  name              String
  designation       String
  qualification     String
  biography         String
  socialUrl         String?
  displayOrder      Int
  isVisible         Boolean         @default(true)
  updatedAt         DateTime        @updatedAt
  aboutLeadership   AboutLeadership @relation(fields: [aboutLeadershipId], references: [id], onDelete: Cascade)

  @@unique([aboutLeadershipId, displayOrder])
  @@index([aboutLeadershipId])
}

model AboutLeadership {
  id          String                  @id @default("singleton")
  heading     String
  description String
  isVisible   Boolean                 @default(true)
  sortOrder   Int                     @default(6)
  updatedAt   DateTime                @updatedAt
  members     AboutLeadershipMember[]
}
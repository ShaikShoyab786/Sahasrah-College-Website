  facultyHeading         String   @default("Our Expert Faculty")
  facultyDescription     String   @default("Experienced subject-matter experts who make difficult ideas clearer and ambitious goals more achievable.")
  facultyButtonLabel     String   @default("More Faculty")
  facultyButtonHref      String   @default("/about#leadership")

model ResultsPageSettings {
  id                  String   @id @default("singleton")
  eyebrow             String
  heading             String
  description         String
  configuredYear      String?
  isVisible           Boolean  @default(true)
  ctaHeading          String   @default("Your next chapter starts here.")
  ctaDescription      String   @default("Connect with our team to learn about admissions and next steps.")
  ctaPrimaryLabel     String   @default("Enquire Now")
  ctaSecondaryLabel   String   @default("Contact Us")
  ctaPrimaryHref      String   @default("/contact")
  ctaSecondaryHref    String   @default("/contact")
  ctaIsVisible        Boolean  @default(true)
  updatedAt           DateTime @updatedAt
}

model HomepageResult {
  id                  String          @id @default(cuid())
  homepageResultsId   String          @default("singleton")
  studentImageUrl     String?
  studentImageAltText String
  studentName         String
  examCourse          String
  score               String
  achievement         String
  resultLabel         String
  examName            String?
  category            String          @default("OTHER")
  year                String?
  institution         String?
  course              String?
  story               String?
  storyIsPublished    Boolean         @default(false)
  storyOrder          Int             @default(1)
  accentColor         String?
  displayOrder        Int
  isActive            Boolean         @default(true)
  isPublished         Boolean         @default(false)
  showInHomePreview   Boolean         @default(false)
  homePreviewOrder    Int             @default(1)
  updatedAt           DateTime        @updatedAt
  homepageResults     HomepageResults @relation(fields: [homepageResultsId], references: [id], onDelete: Cascade)

  @@unique([homepageResultsId, displayOrder])
  @@index([homepageResultsId])
}

model AlumniSuccessStory {
  id                    String   @id @default(cuid())
  displayName           String   @default("")
  portraitUrl           String?
  portraitAltText       String?

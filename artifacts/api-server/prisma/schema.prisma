generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String
  displayName  String
  createdAt    DateTime        @default(now())
  sessions     AdminSession[]
}

model AdminSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  adminId   String
  expiresAt DateTime
  createdAt DateTime @default(now())
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model SiteSettings {
  id           String  @id @default("singleton")
  collegeName  String
  tagline      String
  logoUrl      String?
  email        String
  phone        String
  address      String
  primaryColor String
  accentColor  String
  footerText   String
  updatedAt    DateTime @updatedAt
}

model HomepageHero {
  id                     String  @id @default(cuid())
  displayOrder           Int     @unique @default(1)
  eyebrowText            String
  heading                String
  highlightedHeadingText String
  description            String
  primaryButtonLabel     String
  primaryButtonUrl       String
  secondaryButtonLabel   String
  secondaryButtonUrl     String
  heroImageUrl           String?
  heroImageAltText       String  @default("Sahasara Junior College students learning together")
  isPublished             Boolean @default(true)
  updatedAt              DateTime @updatedAt
}

model HomepageAboutPreview {
  id                    String   @id @default("singleton")
  eyebrow               String
  heading               String
  description           String
  body                  String
  buttonLabel           String
  buttonHref            String
  primaryImage          String?
  primaryImageAltText   String
  secondaryImage        String?
  secondaryImageAltText String
  isVisible             Boolean  @default(true)
  sortOrder             Int      @default(2)
  updatedAt             DateTime @updatedAt
}

model HomepageLiveUpdate {
  id           String   @id @default(cuid())
  title        String
  excerpt      String
  category     String
  actionBadge  String?
  publishDate  DateTime
  imageUrl     String?
  imageAltText String
  detailUrl    String
  isFeatured   Boolean  @default(false)
  isActive     Boolean  @default(true)
  displayOrder Int
  updatedAt    DateTime @updatedAt

  @@unique([displayOrder])
  @@index([isActive, isFeatured, publishDate])
}

model HomepageStatistics {
  id          String               @id @default("singleton")
  eyebrow     String
  heading     String
  description String
  isVisible   Boolean              @default(true)
  sortOrder   Int                  @default(4)
  updatedAt   DateTime             @updatedAt
  statistics  HomepageStatistic[]
}

model HomepageStatistic {
  id                   String             @id @default(cuid())
  homepageStatisticsId String             @default("singleton")
  numericTarget        Int
  suffix               String
  icon                 String?
  label                String
  displayOrder         Int
  isActive             Boolean            @default(true)
  updatedAt            DateTime           @updatedAt
  homepageStatistics   HomepageStatistics @relation(fields: [homepageStatisticsId], references: [id], onDelete: Cascade)

  @@unique([homepageStatisticsId, displayOrder])
  @@index([homepageStatisticsId])
}

model HomepageFavoriteTopics {
  id          String                  @id @default("singleton")
  eyebrow     String
  heading     String
  description String
  isVisible   Boolean                 @default(true)
  sortOrder   Int                     @default(5)
  updatedAt   DateTime                @updatedAt
  topics      HomepageFavoriteTopic[]
}

model HomepageFavoriteTopic {
  id                      String                @id @default(cuid())
  homepageFavoriteTopicsId String               @default("singleton")
  categoryLabel           String
  title                   String
  description             String
  featureOne              String
  featureTwo              String
  featureThree            String
  imageUrl                String?
  imageAltText            String
  icon                    String?
  curriculumUrl           String
  displayOrder            Int
  isActive                Boolean               @default(true)
  updatedAt               DateTime              @updatedAt
  homepageFavoriteTopics  HomepageFavoriteTopics @relation(fields: [homepageFavoriteTopicsId], references: [id], onDelete: Cascade)

  @@unique([homepageFavoriteTopicsId, displayOrder])
  @@index([homepageFavoriteTopicsId])
}

model HomepageResults {
  id          String            @id @default("singleton")
  eyebrow     String
  heading     String
  description String
  isVisible   Boolean           @default(true)
  sortOrder   Int               @default(6)
  updatedAt   DateTime          @updatedAt
  results     HomepageResult[]
}

model HomepageResult {
  id                  String          @id @default(cuid())
  homepageResultsId   String          @default("singleton")
  studentImageUrl     String?
  studentImageAltText String
  studentName         String
  examCourse          String
  score               String
  achievement         String
  resultLabel         String
  examName            String?
  year                String?
  accentColor         String?
  displayOrder        Int
  isActive            Boolean         @default(true)
  updatedAt           DateTime        @updatedAt
  homepageResults     HomepageResults @relation(fields: [homepageResultsId], references: [id], onDelete: Cascade)

  @@unique([homepageResultsId, displayOrder])
  @@index([homepageResultsId])
}

model HomepageAchievementRibbon {
  id          String                         @id @default("singleton")
  isVisible   Boolean                        @default(true)
  sortOrder   Int                            @default(7)
  updatedAt   DateTime                       @updatedAt
  phrases     HomepageAchievementRibbonPhrase[]
}

model HomepageAchievementRibbonPhrase {
  id                         String                    @id @default(cuid())
  homepageAchievementRibbonId String                    @default("singleton")
  phrase                     String
  displayOrder               Int
  isActive                   Boolean                   @default(true)
  accentColor                String?
  separatorStyle             String?                   @default("star")
  updatedAt                  DateTime                  @updatedAt
  homepageAchievementRibbon  HomepageAchievementRibbon @relation(fields: [homepageAchievementRibbonId], references: [id], onDelete: Cascade)

  @@unique([homepageAchievementRibbonId, displayOrder])
  @@index([homepageAchievementRibbonId])
}

model HomepageTestimonials {
  id            String                 @id @default("singleton")
  eyebrow       String
  heading       String
  description   String
  isVisible     Boolean                @default(true)
  sortOrder     Int                    @default(8)
  updatedAt     DateTime               @updatedAt
  testimonials  HomepageTestimonial[]
}

model HomepageTestimonial {
  id                      String                @id @default(cuid())
  homepageTestimonialsId  String                @default("singleton")
  rating                  Int
  quote                   String
  personName              String
  role                    String
  courseAchievement       String
  avatarImageUrl          String?
  avatarAltText           String
  accentColor             String?
  displayOrder            Int
  isActive                Boolean               @default(true)
  updatedAt               DateTime              @updatedAt
  homepageTestimonials    HomepageTestimonials   @relation(fields: [homepageTestimonialsId], references: [id], onDelete: Cascade)

  @@unique([homepageTestimonialsId, displayOrder])
  @@index([homepageTestimonialsId])
}

model AboutHero {
  id                       String   @id @default("singleton")
  eyebrow                  String
  heading                  String
  description              String
  mainImageUrl             String?
  mainImageAltText         String
  floatingLabel             String
  floatingAcademicYear     String
  floatingAvailabilityText String
  floatingSupportingText   String
  floatingImageUrl         String?
  floatingImageAltText     String
  primaryButtonLabel       String
  primaryButtonUrl         String
  primaryButtonVisible     Boolean  @default(true)
  secondaryButtonLabel     String
  secondaryButtonUrl       String
  secondaryButtonVisible   Boolean  @default(true)
  isVisible                Boolean  @default(true)
  sortOrder                Int      @default(1)
  updatedAt                DateTime @updatedAt
  stats                    AboutHeroStat[]
}

model AboutHeroStat {
  id          String    @id @default(cuid())
  aboutHeroId String    @default("singleton")
  value       String
  label       String
  icon        String?
  displayOrder Int
  isVisible   Boolean   @default(true)
  updatedAt   DateTime  @updatedAt
  aboutHero   AboutHero @relation(fields: [aboutHeroId], references: [id], onDelete: Cascade)

  @@unique([aboutHeroId, displayOrder])
  @@index([aboutHeroId])
}

model AboutStory {
  id                    String              @id @default("singleton")
  eyebrow               String
  heading               String
  description           String
  buttonLabel           String
  buttonHref            String
  mainImage              String?
  mainImageAltText       String
  secondaryImage         String?
  secondaryImageAltText  String
  thirdImage             String?
  thirdImageAltText      String
  isVisible              Boolean             @default(true)
  sortOrder              Int                 @default(2)
  updatedAt              DateTime            @updatedAt
  timelineItems         AboutTimelineItem[]
}

model AboutTimelineItem {
  id          String     @id @default(cuid())
  aboutStoryId String    @default("singleton")
  period      String
  title       String
  description String
  displayOrder Int
  isVisible   Boolean    @default(true)
  updatedAt   DateTime   @updatedAt
  aboutStory  AboutStory @relation(fields: [aboutStoryId], references: [id], onDelete: Cascade)

  @@unique([aboutStoryId, displayOrder])
  @@index([aboutStoryId])
}

model AboutChairmanMessage {
  id             String   @id @default("singleton")
  eyebrow        String
  heading        String
  message        String
  signatureName  String
  role           String
  portraitImage  String?
  portraitAltText String
  buttonLabel    String
  buttonHref     String
  buttonVisible  Boolean  @default(false)
  isVisible      Boolean  @default(true)
  sortOrder      Int      @default(3)
  updatedAt      DateTime @updatedAt
}

model AboutGuidingPrinciples {
  id                String                    @id @default("singleton")
  heading           String
  description       String
  visionIcon        String
  visionTitle       String
  visionDescription String
  missionIcon       String
  missionTitle      String
  missionDescription String
  valuesIcon        String
  valuesTitle       String
  isVisible         Boolean                   @default(true)
  sortOrder         Int                       @default(4)
  updatedAt         DateTime                  @updatedAt
  values            AboutGuidingPrincipleValue[]
}

model AboutGuidingPrincipleValue {
  id                    String                  @id @default(cuid())
  aboutGuidingPrinciplesId String                @default("singleton")
  value                 String
  displayOrder          Int
  isVisible             Boolean                 @default(true)
  updatedAt             DateTime                @updatedAt
  aboutGuidingPrinciples AboutGuidingPrinciples @relation(fields: [aboutGuidingPrinciplesId], references: [id], onDelete: Cascade)

  @@unique([aboutGuidingPrinciplesId, displayOrder])
  @@index([aboutGuidingPrinciplesId])
}

model AboutWhyParentsChoose {
  id          String                    @id @default("singleton")
  heading     String
  description String
  isVisible   Boolean                   @default(true)
  sortOrder   Int                       @default(5)
  updatedAt   DateTime                  @updatedAt
  benefits    AboutParentChoiceBenefit[]
}

model AboutParentChoiceBenefit {
  id                   String                @id @default(cuid())
  aboutWhyParentsChooseId String             @default("singleton")
  icon                 String
  title                String
  description          String
  displayOrder         Int
  isVisible            Boolean               @default(true)
  updatedAt            DateTime              @updatedAt
  aboutWhyParentsChoose AboutWhyParentsChoose @relation(fields: [aboutWhyParentsChooseId], references: [id], onDelete: Cascade)

  @@unique([aboutWhyParentsChooseId, displayOrder])
  @@index([aboutWhyParentsChooseId])
}

model AboutLeadershipMember {
  id                String          @id @default(cuid())
  aboutLeadershipId String          @default("singleton")
  portraitImage     String?
  portraitAltText   String
  name              String
  designation       String
  qualification     String
  biography         String
  socialUrl         String?
  subject           String?
  experience        String?
  homepageProfileUrl String?
  homepageActive    Boolean         @default(true)
  displayOrder      Int
  isVisible         Boolean         @default(true)
  updatedAt         DateTime        @updatedAt
  aboutLeadership   AboutLeadership @relation(fields: [aboutLeadershipId], references: [id], onDelete: Cascade)

  @@unique([aboutLeadershipId, displayOrder])
  @@index([aboutLeadershipId])
}

model AboutLeadership {
  id          String                  @id @default("singleton")
  heading     String
  description String
  isVisible   Boolean                 @default(true)
  sortOrder   Int                     @default(6)
  updatedAt   DateTime                @updatedAt
  members     AboutLeadershipMember[]
}

model AboutCampusHighlights {
  id          String                  @id @default("singleton")
  heading     String
  description String
  isVisible   Boolean                 @default(true)
  sortOrder   Int                     @default(7)
  updatedAt   DateTime                @updatedAt
  highlights  AboutCampusHighlight[]
}

model AboutCampusHighlight {
  id                    String                @id @default(cuid())
  aboutCampusHighlightsId String              @default("singleton")
  imageUrl              String?
  imageAltText          String
  icon                  String?
  title                 String
  description           String
  category              String?
  locationLabel         String?
  homepageFeatured      Boolean               @default(true)
  homepageActive        Boolean               @default(true)
  displayOrder          Int
  isVisible             Boolean               @default(true)
  updatedAt             DateTime              @updatedAt
  aboutCampusHighlights  AboutCampusHighlights @relation(fields: [aboutCampusHighlightsId], references: [id], onDelete: Cascade)

  @@unique([aboutCampusHighlightsId, displayOrder])
  @@index([aboutCampusHighlightsId])
}

model AboutAchievements {
  id          String                    @id @default("singleton")
  heading     String
  description String
  isVisible   Boolean                   @default(true)
  sortOrder   Int                       @default(8)
  updatedAt   DateTime                  @updatedAt
  statistics  AboutAchievementStatistic[]
}

model AboutAchievementStatistic {
  id                  String           @id @default(cuid())
  aboutAchievementsId String           @default("singleton")
  numericTarget       Int
  suffix              String
  icon                String?
  label               String
  displayOrder        Int
  isVisible           Boolean          @default(true)
  updatedAt           DateTime         @updatedAt
  aboutAchievements   AboutAchievements @relation(fields: [aboutAchievementsId], references: [id], onDelete: Cascade)

  @@unique([aboutAchievementsId, displayOrder])
  @@index([aboutAchievementsId])
}

model AboutFaq {
  id          String         @id @default("singleton")
  heading     String
  description String
  isVisible   Boolean        @default(true)
  sortOrder   Int            @default(9)
  updatedAt   DateTime       @updatedAt
  questions   AboutFaqItem[]
}

model AboutFaqItem {
  id          String      @id @default(cuid())
  aboutFaqId  String      @default("singleton")
  question    String
  answer      String
  displayOrder Int
  isVisible   Boolean     @default(true)
  updatedAt   DateTime    @updatedAt
  aboutFaq    AboutFaq    @relation(fields: [aboutFaqId], references: [id], onDelete: Cascade)

  @@unique([aboutFaqId, displayOrder])
  @@index([aboutFaqId])
}

model AboutAdmissionCta {
  id                    String   @id @default("singleton")
  heading               String
  supportingText        String
  applyButtonLabel      String
  applyButtonHref       String
  campusVisitButtonLabel String
  campusVisitButtonHref String
  prospectusButtonLabel String
  prospectusButtonHref  String
  backgroundImage       String?
  backgroundImageAltText String
  counselorButtonLabel  String
  counselorButtonHref   String
  admissionPhone        String
  workingHours          String
  isVisible             Boolean  @default(true)
  sortOrder             Int      @default(10)
  updatedAt             DateTime @updatedAt
}